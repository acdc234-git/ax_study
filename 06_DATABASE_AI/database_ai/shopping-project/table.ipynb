    "\n",
    "url = os.getenv(\"SUPABASE_URL\")\n",
    "key = os.getenv(\"SUPABASE_PUBLISHABLE_KEY\")\n",
    "\n",
    "supabase = create_client(url, key)\n",
    "\n",
    "\n"
   ]
